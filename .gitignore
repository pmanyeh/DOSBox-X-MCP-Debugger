# Virtual environment
.venv/
venv/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Session-local scratch output: campaign traces, generated MCP configs,
# OAuth/preflight artifacts, agent transcripts, evidence logs, one-off
# driver scripts -- none of this is reproducible project source, all of
# it is produced fresh by re-running the tests/tests.phase5c campaigns
# documented in docs/. Never intended for publication.
scratchpad/

# Claude Code tool-local session state (session id/PID/lock files) --
# not project source, regenerated per session.
.claude/

# Local logs / crash dumps, wherever they might land.
*.log
*.dmp

# Local environment / secrets files, if ever created.
.env
.env.*

# Phase 8C agent-side knowledge store (ai/knowledge.py's default path):
# an agent's own symbols/comments/xrefs for whatever target program it is
# currently reverse-engineering -- user/session-specific findings, never
# project source.
ai/knowledge.local.json

# Ad hoc local "run copies" of the built DOSBox-X binary (dosbox-x.exe,
# .pdb, and its full runtime asset set), made at the repo root for manual
# testing convenience -- e.g. build-memory/, build-selector/. The real
# build output lives in dosbox-src/bin/ (already git-ignored inside the
# submodule); these are just scratch deployment copies, tens/hundreds of
# MB each, never meant to be committed.
/build-*/
